---
/**
 * Filterable project portfolio (Steps P5.8–P5.23)
 * Sticky filter toolbar, six project cards, accessible filtering,
 * live project count, and per-card specification disclosures.
 */
import Container from '../Container.astro';
import ProjectCard from './ProjectCard.astro';

const demoProjects = [
  {
    id: 'ind-01',
    category: 'industrial',
    categoryLabel: 'Industrial',
    categoryChip: 'bg-surface-container-lowest text-primary',
    subTag: 'HV/LV',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of MV/LV distribution switchgear, panels and cabling.',
    locationIcon: 'text-primary-fixed',
    ref: 'MV/LV Scope',
    refColor: 'text-primary',
    typePlaceholder: 'Industrial Sector',
    titlePlaceholder: 'Industrial Power Distribution & Installation',
    summaryPlaceholder: 'MV/LV distribution, MDB and SMDB panel installation, cable tray fixing and cable laying for factories, plants and other industrial facilities.',
    specLabel: 'Execution Scope',
    specValue: 'MV/LV Distribution & Panels',
    specDetail: 'Work covers incoming supply distribution, main and sub-main distribution board installation, cable tray routes, cable laying and terminations carried out to match the site load requirements.',
  },
  {
    id: 'com-02',
    category: 'commercial',
    categoryLabel: 'Commercial',
    categoryChip: 'bg-surface-container-lowest text-tertiary',
    subTag: 'MDB Panels',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of a commercial main distribution board and its outgoing circuits.',
    locationIcon: 'text-tertiary-fixed',
    ref: 'Panel Scope',
    refColor: 'text-tertiary',
    typePlaceholder: 'Commercial Sector',
    titlePlaceholder: 'Commercial Panel & Distribution Work',
    summaryPlaceholder: 'Main and sub-main distribution boards, cable tray routes and power installation for commercial buildings, offices and retail premises.',
    specLabel: 'System Architecture',
    specValue: 'MDB & Sub-Main Distribution',
    specDetail: 'Panels are arranged around the building main and sub-main distribution points, with tray and conduit routes planned alongside the electrical layout so circuits stay grouped and serviceable.',
  },
  {
    id: 'elv-03',
    category: 'elv',
    categoryLabel: 'ELV Solutions',
    categoryChip: 'bg-secondary-container text-on-secondary-fixed',
    subTag: 'Automation',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of structured cabling and connected low-voltage building systems.',
    locationIcon: 'text-secondary-fixed',
    ref: 'Integration Scope',
    refColor: 'text-tertiary',
    typePlaceholder: 'ELV & Automation',
    titlePlaceholder: 'ELV & Building Automation Systems',
    summaryPlaceholder: 'Structured cabling, containment and connected low-voltage systems such as access control, CCTV, intercom and building automation for commercial and residential sites.',
    specLabel: 'Integration Points',
    specValue: 'Structured Cabling & Controls',
    specDetail: 'Low-voltage systems are routed and terminated on their own containment, keeping power, data and control circuits separated, labelled and easy to maintain.',
  },
  {
    id: 'res-04',
    category: 'residential',
    categoryLabel: 'Residential',
    categoryChip: 'bg-surface-container-lowest text-on-surface',
    subTag: 'Smart Power',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of residential wiring, a distribution board and connected circuits.',
    locationIcon: 'text-primary-fixed',
    ref: 'Wiring Scope',
    refColor: 'text-secondary',
    typePlaceholder: 'Residential Sector',
    titlePlaceholder: 'Residential & Commercial Wiring',
    summaryPlaceholder: 'House wiring, rewiring, distribution board installation and power point work for homes, extensions and renovation projects, alongside commercial fit-outs.',
    specLabel: 'Specialty',
    specValue: 'Complete Wiring & Rewiring',
    specDetail: 'Circuit layout, conduit and box work, switch and socket installation and distribution board connections for both new builds and upgrades to existing wiring.',
  },
  {
    id: 'lps-05',
    category: 'industrial',
    categoryLabel: 'Lightning Protection',
    categoryChip: 'bg-error-container text-on-error-container',
    subTag: 'Surge Safe',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of air terminals, down conductors and earthing conductors on a structure.',
    locationIcon: 'text-primary-fixed',
    ref: 'Protection Scope',
    refColor: 'text-error',
    typePlaceholder: 'Lightning Protection',
    titlePlaceholder: 'Lightning & Surge Protection Systems',
    summaryPlaceholder: 'Air terminals, down conductors, bonding and earthing, plus surge protective devices, installed to give structures and equipment a clear path to earth.',
    specLabel: 'Protection System',
    specValue: 'Air Terminals & Earthing',
    specDetail: 'A protection layout runs from air terminals through down conductors and bonding to earth pits and earthing conductors, with surge protection added for sensitive equipment.',
  },
  {
    id: 'tst-06',
    category: 'maintenance',
    categoryLabel: 'Testing & Commissioning',
    categoryChip: 'bg-secondary-fixed text-on-secondary-fixed',
    subTag: 'Inspection',
    imgSrc: '/images/project-scope.svg',
    imgAlt: 'Schematic of test instruments connected to an electrical installation.',
    locationIcon: 'text-primary-fixed',
    ref: 'Test Scope',
    refColor: 'text-tertiary',
    typePlaceholder: 'Testing & Commissioning',
    titlePlaceholder: 'Electrical Testing & Commissioning',
    summaryPlaceholder: 'Insulation resistance, earth continuity, earth loop impedance and functional checks carried out before an installation is handed over to the client.',
    specLabel: 'Test Protocol',
    specValue: 'Insulation, Continuity & Loop Impedance',
    specDetail: 'Circuits are tested for insulation resistance, earth continuity and earth loop impedance, then checked functionally so the installation is confirmed ready for use before handover.',
  },
