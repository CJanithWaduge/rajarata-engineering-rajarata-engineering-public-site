---
import { faFacebook } from '@fortawesome/free-brands-svg-icons';

interface Props {
  class?: string;
}

const { class: className = 'h-5 w-5' } = Astro.props;
const [width, height, , , path] = faFacebook.icon;
const pathData = Array.isArray(path) ? path.join(' ') : path;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  fill="currentColor"
  class:list={['shrink-0', className]}
  aria-hidden="true"
  focusable="false"
>
  <path d={pathData} />
</svg>
