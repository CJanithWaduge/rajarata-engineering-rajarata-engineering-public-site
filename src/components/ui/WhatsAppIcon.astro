---
import { siWhatsapp } from 'simple-icons';

interface Props {
  class?: string;
}

const { class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  class:list={['shrink-0', className]}
  aria-hidden="true"
  focusable="false"
>
  <path d={siWhatsapp.path} />
</svg>
