---
/**
 * Services directory (Steps S3.17–S3.28)
 * Section shell, heading row, and responsive card grid.
 */
import ServiceCard from './ServiceCard.astro';
---

<section class="w-full py-16 sm:py-24 bg-surface" data-scroll-reveal>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
      <div>
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-bold">Engineering Services Directory</span>
        <h2 class="font-headline-lg text-headline-md sm:text-headline-lg text-on-surface tracking-tight mt-1">
          Complete Electrical Lifecycle Capabilities
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary max-w-[28rem]">
        Each service below sets out what the work involves, the scope it covers, and the kinds of buildings and facilities it suits — from first fix through to testing and handover.
      </p>
    </div>
    <!-- Services 2-Column Desktop Grid / 1-Column Mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      <!-- 01 Residential & Commercial Electrical Wiring -->
      <ServiceCard
        id="service-01"
        number="01"
        categoryIcon="apartment"
        categoryLabel="LV Distribution"
        title="Residential & Commercial Electrical Wiring"
        description="Complete electrical wiring for homes, commercial buildings, and retail fit-outs — incoming supply, distribution boards, final circuits, lighting, power outlets, and wiring accessories."
        scope="Lighting and power circuits, socket outlets and switches, distribution board wiring, and concealed or surface containment, with continuity, polarity, and insulation resistance checks on completion."
        suitableFor={['Residential complexes', 'Commercial buildings', 'Retail plazas', 'Corporate headquarters']}
      />
      <!-- 02 Industrial Electrical Installations -->
      <ServiceCard
        id="service-02"
        number="02"
        accent="error"
        categoryIcon="precision_manufacturing"
        categoryLabel="Industrial Grade"
        title="Industrial Electrical Installations"
        description="Electrical installation work for factories, processing plants, and workshops — plant distribution, control equipment, and the cable infrastructure that connects them."
        scope="Plant distribution boards and feeders, motor and control wiring, containment routed through production areas, and termination to machinery and control panels."
        suitableFor={['Manufacturing plants', 'Processing facilities', 'Agro-processing factories', 'Logistics hubs']}
      />
      <!-- 03 MDB / SMDB Panel Installation -->
      <ServiceCard
        id="service-03"
        number="03"
        categoryIcon="developer_board"
        categoryLabel="Switchgear & Enclosures"
        title="MDB / SMDB Panel Installation"
        description="Supply, assembly, and installation of main distribution boards and sub-main distribution boards for buildings and industrial sites."
        scope="Enclosure mounting, busbar and protective device installation, outgoing way wiring, metering provision, and circuit labelling, with terminal torque checks throughout."
        suitableFor={['High-rise developments', 'Substation buildings', 'Commercial complexes', 'Hospitals']}
      />
      <!-- 04 Cable Tray Installation & Cable Laying -->
      <ServiceCard
        id="service-04"
        number="04"
        accent="surface"
        categoryIcon="linear_scale"
        categoryLabel="Containment & Pulling"
        title="Cable Tray Installation & Cable Laying"
        description="Cable containment and cable laying, routing power and control cables safely from supply points to panels, equipment, and distribution rooms."
        scope="Tray, trunking, and conduit installation, cable pulling and fixing, glanding and termination at both ends, and labelling of every circuit on the drum schedule."
        suitableFor={['Utility infrastructure', 'Power distribution rooms', 'Processing facilities', 'Campus networks']}
      />
      <!-- 05 Testing & Commissioning -->
      <ServiceCard
        id="service-05"
        number="05"
        accent="error"
        categoryIcon="fact_check"
        categoryLabel="Testing & Recording"
        title="Testing & Commissioning"
        description="Electrical testing and commissioning carried out before a new installation is energised or an existing one goes into service."
        scope="Visual inspection, continuity and polarity checks, insulation resistance testing, earth loop impedance testing, RCD functional testing, and recorded results for each circuit."
        suitableFor={['New plant commissioning', 'Refurbishment projects', 'Facility handovers', 'Pre-energisation checks']}
      />
      <!-- 06 Electrical Maintenance & Troubleshooting -->
      <ServiceCard
        id="service-06"
        number="06"
        accent="surface"
        categoryIcon="build"
        categoryLabel="Maintenance & Fault Finding"
        title="Electrical Maintenance & Troubleshooting"
        description="Planned maintenance and fault finding for existing electrical installations, from routine inspection rounds to diagnosing breakdowns on lighting, power, and distribution circuits."
        scope="Scheduled visual and thermal inspection, fault diagnosis, repair or replacement of damaged components, and re-testing of affected circuits after the work is complete."
        suitableFor={['Critical healthcare centers', 'Hotel chains', 'Automated factories', 'Commercial properties']}
      />
      <!-- 07 All Kinds of ELV Solutions -->
      <ServiceCard
        id="service-07"
        number="07"
        accent="tertiary"
        categoryIcon="router"
        categoryLabel="ELV & Automation"
        title="All Kinds of ELV Solutions"
        description="Extra-low-voltage systems — communications, access control, security, and building automation — designed and installed to integrate with the wider electrical installation."
        scope="Structured cabling and communications wiring, access control and CCTV, door entry and alarm systems, and building control integration, routed and terminated on dedicated ELV containment."
        suitableFor={['Smart office towers', 'Luxury residential villas', 'Hospitality resorts', 'Educational universities']}
      />
      <!-- 08 Lightning Protection System (LPS) -->
      <ServiceCard
        id="service-08"
        number="08"
        accent="error"
        categoryIcon="bolt"
        categoryLabel="Surge & Transient Defense"
        title="Lightning Protection System (LPS)"
        description="Lightning protection and surge protection for buildings and structures, from air terminals at the roof down to the earth electrode in the ground."
        scope="Air terminals and down conductors, earthing conductors and earth pits, equipotential bonding, surge protective devices at distribution boards, and continuity measurements across the finished system."
        suitableFor={['Data centers & telecom towers', 'Elevated commercial towers', 'Chemical & fuel depots', 'Industrial compounds']}
      />
    </div>
  </div>
</section>
