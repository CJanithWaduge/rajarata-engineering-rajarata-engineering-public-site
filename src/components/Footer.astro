---
/**
 * Site footer.
 *
 * Light surface. The prototypes use a near-black footer (#0b0f17) with
 * colours that are not in DESIGN.md — a second red (#ef4444) and a grey
 * (#9ca3af) that exists nowhere else in the system. That palette has been
 * dropped in favour of the approved tokens.
 *
 * Every foreground/background pair below was contrast-checked against
 * surface-container-low (#f3f3f3); all pass WCAG AA. See the WhatsApp block
 * in global.css for the one deliberate exception to the palette.
 *
 * Business details are baked into the static build from build-time environment
 * values; nothing is fetched at runtime.
 */
import Container from './Container.astro';
import Logo from './Logo.astro';
import FacebookIcon from './ui/FacebookIcon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { phoneContact, whatsappContact } from '../lib/publicContact';
import { parseEmail, parseHttpUrl, isUnset } from '../lib/siteSettings';
import { Phone } from '@lucide/astro';
import BrandIcon from './ui/BrandIcon.astro';
import { siGmail, siGooglemaps } from 'simple-icons';

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
];

// The prototype lists seven, not the six the plan mentions. Kept as-is
// rather than dropping one to hit the count.
const services = [
  { label: 'Residential & Commercial Wiring', href: '/services#service-01' },
  { label: 'Industrial Installations', href: '/services#service-02' },
  { label: 'MDB / SMDB Panel Installation', href: '/services#service-03' },
  { label: 'Cable Tray & Laying', href: '/services#service-04' },
  { label: 'Testing & Commissioning', href: '/services#service-05' },
  { label: 'ELV Solutions & Automation', href: '/services#service-07' },
  { label: 'Lightning Protection System', href: '/services#service-08' },
];

const badges = ['Direct contact', 'WhatsApp & phone'];

const year = new Date().getFullYear();
const publicPhone = phoneContact;
const publicWhatsApp = whatsappContact;
const displayedServices = services;

// Build-time values are the initial paint; `watchSiteSettings` replaces them
// with the live Firestore values once the client hydrates. Kept in env so the
// static HTML is correct before JavaScript runs.
const emailContact = parseEmail(import.meta.env.PUBLIC_EMAIL ?? '');
const facebookContact = parseHttpUrl(import.meta.env.PUBLIC_FACEBOOK_URL ?? '');
const locationDisplay = isUnset(import.meta.env.PUBLIC_LOCATION)
  ? 'Location details to be confirmed'
  : import.meta.env.PUBLIC_LOCATION;

// Focus rings on a light footer need the ink outline, not the white one the
// dark footer used.
const focus = 'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
---

<footer
  class="w-full bg-surface-container-low text-secondary font-body-sm text-body-sm border-t border-outline-variant"
>
  <Container class="pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Column 1 — brand -->
      <div class="lg:col-span-4 flex flex-col space-y-4">
        <a href="/" class={`flex items-center gap-3 w-fit ${focus}`}>
          <Logo class="h-10 w-auto" />
          <span class="flex flex-col">
            <span class="font-title-lg text-title-lg tracking-tight text-on-surface uppercase"
              >Rajarata</span
            >
            <span
              class="font-label-caps text-label-caps tracking-widest text-primary uppercase"
              >Engineering</span
            >
          </span>
        </a>
        <p class="text-secondary font-body-md text-body-md pr-4 leading-relaxed">
          Contact the team directly by WhatsApp or phone. Email and Facebook details are being confirmed.
        </p>
        <div class="flex items-center gap-2 pt-2">
          {
            badges.map((badge) => (
              <span class="inline-flex items-center px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-label-caps text-label-caps uppercase">
                {badge}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Column 2 — quick links -->
      <nav class="lg:col-span-2 flex flex-col space-y-3" aria-label="Footer">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Quick Links</span
        >
        <ul class="space-y-2.5 mt-2">
          {
            quickLinks.map((item) => (
              <li class="h-7 flex items-center">
                <a
                  href={item.href}
                  class={`hover:text-on-surface transition-colors ${focus}`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Column 3 — services -->
      <nav class="lg:col-span-3 flex flex-col space-y-3" aria-label="Services">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Our Services</span
        >
        <ul class="space-y-2.5 mt-2">
          {
            displayedServices.map((service) => (
              <li class="h-7 flex items-center">
                <a
                  href={service.href}
                  class={`hover:text-on-surface transition-colors truncate ${focus}`}
                >
                  {service.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Column 4 — contact -->
      <div class="lg:col-span-3 flex flex-col space-y-3">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Contact Info</span
        >
        <div class="space-y-3 mt-2">
          {publicPhone.status === 'ready' && (
            <div data-site-row>
              <a
                href={publicPhone.href}
                data-site-phone
                aria-label={`Call Rajarata Engineering at ${publicPhone.displayNumber}`}
                class={`inline-flex min-h-11 items-center gap-2 break-all font-label-md text-label-md text-on-surface underline-offset-4 hover:text-primary hover:underline ${focus}`}
              >
                <Phone class="h-5 w-5 text-primary" stroke-width="1.8" aria-hidden="true" />
                <span data-site-value>{publicPhone.displayNumber}</span>
              </a>
            </div>
          )}
          {publicWhatsApp.status === 'ready' && (
            <div data-site-row>
              <a
                href={publicWhatsApp.href}
                data-site-whatsapp
                data-site-format="whatsapp"
                aria-label={`Chat with Rajarata Engineering on WhatsApp at ${publicWhatsApp.displayNumber}`}
                class={`inline-flex min-h-11 max-w-full flex-wrap items-center gap-2 break-all rounded-control bg-whatsapp px-3 py-2 font-label-sm text-label-sm text-white transition-colors hover:bg-whatsapp-hover active:translate-y-px ${focus}`}
              >
                <WhatsAppIcon class="h-5 w-5" />
                <span data-site-value>{publicWhatsApp.displayNumber}</span>
              </a>
            </div>
          )}
          <div class="flex items-start gap-2 font-body-sm text-body-sm text-secondary" data-site-row>
            <BrandIcon icon={siGmail} class="h-5 w-5 text-[#EA4335]" />
            <a
              class="break-all underline-offset-4 hover:text-primary hover:underline"
              data-site-email
              href={`mailto:${emailContact.status === 'ready' ? emailContact.value : ''}`}
            >{emailContact.status === 'ready' ? emailContact.value : 'Email address to be confirmed'}</a>
          </div>
          <div class="flex items-start gap-2 font-body-sm text-body-sm text-secondary" data-site-row>
            <BrandIcon icon={siGooglemaps} class="h-5 w-5 text-[#4285F4]" />
            <span class="whitespace-pre-line" data-site-address>{locationDisplay}</span>
          </div>
          <div class="flex items-start gap-2 font-body-sm text-body-sm text-secondary" data-site-row>
            <FacebookIcon class="h-5 w-5 text-tertiary" />
            <a
              class="break-all underline-offset-4 hover:text-primary hover:underline"
              data-site-facebookUrl
              href={facebookContact.status === 'ready' ? facebookContact.value : '#'}
            >{facebookContact.status === 'ready' ? 'Facebook' : 'Facebook page link to be confirmed'}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-outline-variant"
    >
      <p class="text-xs text-secondary">
        &copy; {year} Rajarata Engineering.
      </p>
    </div>
  </Container>
</footer>