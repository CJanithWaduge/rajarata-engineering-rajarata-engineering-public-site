---
/**
 * Engineering consultation CTA (Steps A4.44–A4.48)
 * Dark grid CTA panel with direct contact and project actions.
 */
import Container from '../Container.astro';
import { getPublicContactActions } from '../../lib/publicContact';

const { primary: primaryContactAction } = getPublicContactActions();
---

<section class="w-full bg-surface-container-lowest px-4 py-14 sm:px-6 sm:py-20 lg:px-8" data-scroll-reveal>
  <Container>
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl border border-white/10 bg-[#1e1e1e] p-6 shadow-2xl sm:p-10 md:p-16">
      <div class="pointer-events-none absolute inset-0 opacity-[0.04]">
        <svg height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern height="24" id="about-cta-grid" patternUnits="userSpaceOnUse" width="24">
              <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#ffffff" stroke-width="1"></path>
            </pattern>
          </defs>
          <rect fill="url(#about-cta-grid)" height="100%" width="100%"></rect>
        </svg>
      </div>
      <div class="relative z-10">
        <div class="mb-7 inline-flex items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-1.5 font-label-caps text-label-caps uppercase tracking-wider text-gray-200">
          <span class="material-symbols-outlined text-[16px] text-gray-400">engineering</span>
          <span data-about-cta-eyebrow>Engineering Consultation</span>
        </div>
        <h2 class="mb-4 max-w-4xl font-display-hero text-headline-lg leading-tight tracking-tight text-white sm:text-display-hero" data-about-cta-title>
          Plan Your Next Electrical Installation
        </h2>
        <p class="mb-9 max-w-4xl font-body-md text-body-md leading-relaxed text-gray-300 sm:font-body-lg sm:text-[22px] sm:leading-9" data-about-cta-body>
          Reach the team directly by WhatsApp or phone to discuss MV/LV distribution, panel installation, cable work, testing and commissioning, or ELV and automation for your site.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-primary-container px-7 py-4 font-label-md text-label-md text-on-primary shadow-lg shadow-primary/20 transition-all duration-200 hover:bg-primary active:scale-[0.98] focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-fixed-dim sm:text-lg" data-path="contact" data-site-primary-contact href={primaryContactAction.href} target={primaryContactAction.opensInNewTab ? '_blank' : undefined} rel={primaryContactAction.opensInNewTab ? 'noopener noreferrer' : undefined}>
            <span data-site-primary-label>{primaryContactAction.label}</span>
            <span class="material-symbols-outlined -rotate-12 text-[18px]">send</span>
          </a>
          <a class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-white/10 bg-white/5 px-7 py-4 font-label-md text-label-md text-gray-200 transition-colors duration-200 hover:border-white/20 hover:bg-white/10 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-fixed-dim sm:text-lg" data-path="projects" href="/projects">
            <span data-about-cta-projects-label>View Past Projects</span>
            <span class="material-symbols-outlined text-[18px] text-gray-400">layers</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>