---
/**
 * Vision and mission (Steps A4.18–A4.20)
 * Paired Vision and Mission content blocks.
 */
import Container from '../Container.astro';
---

<section class="w-full py-12 bg-surface-container-low" data-scroll-reveal>
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Vision Card (Primary Red Theme) -->
      <div class="card-interactive card-tilt relative bg-surface-container-lowest p-6 lg:p-7 rounded-2xl shadow-sm flex flex-col justify-between overflow-hidden" data-card-tilt data-about-card="vision">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-primary"></div>
        <div>
          <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[28px]">lightbulb</span>
          </div>
          <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary" data-about-card-eyebrow>Strategic Horizon</span>
          <h2 class="font-headline-sm text-headline-sm text-on-surface mt-1.5 mb-3" data-about-card-title>Our Vision</h2>
          <p class="font-body-md text-body-md text-secondary leading-relaxed" data-about-card-body>
            To be an electrical contractor known for careful work — planning every installation properly, testing it thoroughly, and standing behind the result on every site we work on.
          </p>
        </div>
        <div class="mt-6 pt-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-[18px]">electric_bolt</span>
          <span class="font-label-sm text-label-sm text-on-surface font-semibold uppercase tracking-wider" data-about-card-footer>Engineering Future-Ready Infrastructure</span>
        </div>
      </div>
      <!-- Mission Card (Dark Charcoal Industrial Theme) -->
      <div class="card-interactive card-tilt relative bg-inverse-surface text-on-primary p-6 lg:p-7 rounded-2xl shadow-sm flex flex-col justify-between overflow-hidden" data-card-tilt data-about-card="mission">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-secondary"></div>
        <div>
          <div class="w-12 h-12 rounded-xl bg-on-surface/20 flex items-center justify-center text-white mb-4">
            <span class="material-symbols-outlined text-[28px]">verified_user</span>
          </div>
          <span class="font-label-caps text-label-caps uppercase tracking-widest text-gray-400" data-about-card-eyebrow>Tactical Purpose</span>
          <h2 class="font-headline-sm text-headline-sm text-white mt-1.5 mb-3" data-about-card-title>Our Mission</h2>
          <p class="font-body-md text-body-md text-gray-300 leading-relaxed" data-about-card-body>
            To carry out MV/LV distribution, industrial installations, MDB/SMDB panel installation, cable tray and cable laying, lightning protection systems, ELV and automation, and residential and commercial wiring with careful planning, clean installation, and testing before every handover.
          </p>
        </div>
        <div class="mt-6 pt-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-[18px]">handshake</span>
          <span class="font-label-sm text-label-sm text-gray-300 font-semibold uppercase tracking-wider" data-about-card-footer>Uncompromising Safety &amp; Quality Governance</span>
        </div>
      </div>
    </div>
  </Container>
</section>