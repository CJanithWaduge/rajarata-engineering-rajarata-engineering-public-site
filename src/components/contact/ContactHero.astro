---
/**
 * Contact hero.
 *
 * Breadcrumb, main heading, and the engineering-consultation value
 * proposition. No eyebrow pill — the design spec leads with the heading.
 */
import Container from '../Container.astro';
---

<section class="relative w-full bg-surface-container-low py-12 lg:py-16 overflow-hidden" data-scroll-reveal>
  <!-- Primary Glow Accent -->
  <div
    class="absolute -right-20 -top-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <!-- Secondary Glow Accent -->
  <div
    class="absolute left-1/3 -bottom-20 w-80 h-80 rounded-full bg-tertiary/5 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <Container class="relative z-10">
    <nav
      aria-label="Breadcrumb"
      class="flex items-center gap-2 font-label-sm text-label-sm text-secondary mb-6"
    >
      <a
        class="hover:text-primary transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
        data-path="home"
        href="/"
      >
        Home
      </a>
      <span class="material-symbols-outlined text-[16px] text-secondary">chevron_right</span>
      <span class="text-on-surface font-title-md">Contact</span>
    </nav>
    <div class="flex flex-col space-y-4">
      <h1
        class="font-headline-lg text-headline-lg lg:text-[48px] lg:leading-[56px] text-on-surface tracking-tight font-extrabold"
      >
        Let's Talk About Your{' '}
        <span class="text-primary underline decoration-primary/20 underline-offset-8">
          Project
        </span>
      </h1>
      <p class="font-body-lg text-body-lg text-secondary max-w-[42rem] leading-relaxed">
        Get in touch with our engineering team for fast project consultations,
        MV/LV distribution quotes, or custom industrial installations.
      </p>
    </div>
  </Container>
</section>
