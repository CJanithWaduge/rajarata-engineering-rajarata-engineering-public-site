---
/** Direct phone and WhatsApp actions for the Contact page. */
import Container from '../Container.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { phoneContact, whatsappContact } from '../../lib/publicContact';

const phone = phoneContact;
const whatsapp = whatsappContact;
---

<section id="contact-options" class="w-full py-16 bg-surface" data-scroll-reveal>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-7 flex flex-col justify-between rounded-2xl border border-outline-variant bg-surface-container-lowest p-8 shadow-sm sm:p-10">
        <div>
          <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">
            Direct contact
          </span>
          <h2 class="mt-3 font-headline-md text-headline-md tracking-tight text-on-surface">
            Talk with our team
          </h2>
          <p class="mt-3 w-full max-w-[42rem] font-body-md text-body-md leading-relaxed text-secondary">
            Choose the way that works best for you. No inquiry form or email submission is needed.
          </p>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {whatsapp.status === 'ready' && (
            <a
              href={whatsapp.href}
              aria-label={`Chat with Rajarata Engineering on WhatsApp at ${whatsapp.displayNumber}`}
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-control bg-whatsapp px-5 py-3 font-label-md text-label-md text-white transition-colors hover:bg-whatsapp-hover active:translate-y-px focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <WhatsAppIcon class="h-5 w-5" />
              <span>Chat on WhatsApp</span>
            </a>
          )}
          {phone.status === 'ready' && (
            <a
              href={phone.href}
              aria-label={`Call Rajarata Engineering at ${phone.displayNumber}`}
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-control border border-outline-variant bg-surface px-5 py-3 font-label-md text-label-md text-on-surface transition-colors hover:bg-surface-container-high active:translate-y-px focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <span class="material-symbols-outlined" aria-hidden="true">call</span>
              <span>Call {phone.displayNumber}</span>
            </a>
          )}
        </div>
      </div>
      <div class="lg:col-span-5 flex flex-col rounded-2xl border border-outline-variant bg-surface-container-low p-6 shadow-sm sm:p-8">
        <div class="flex min-h-36 items-center justify-center overflow-hidden rounded-xl border border-outline-variant bg-surface-container-high">
          <svg
            class="h-36 w-full text-tertiary"
            viewBox="0 0 360 144"
            fill="none"
            aria-hidden="true"
          >
            <path d="M0 36H360M0 72H360M0 108H360M60 0V144M120 0V144M180 0V144M240 0V144M300 0V144" stroke="currentColor" stroke-opacity=".16" />
            <path d="M28 116 86 93 130 103 184 63 234 76 285 34 334 45" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <circle class="fill-primary/10" cx="184" cy="63" r="22" />
            <path class="fill-primary" d="M184 49a12 12 0 0 0-12 12c0 9 12 23 12 23s12-14 12-23a12 12 0 0 0-12-12Zm0 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" />
          </svg>
        </div>
        <div class="mt-6 flex flex-col gap-3">
          <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">
            Location
          </span>
          <h3 class="font-headline-sm text-headline-sm tracking-tight text-on-surface">
            Location details to be confirmed
          </h3>
          <p class="font-body-sm text-body-sm leading-relaxed text-secondary">
            A verified business address will be added here once it is provided.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>