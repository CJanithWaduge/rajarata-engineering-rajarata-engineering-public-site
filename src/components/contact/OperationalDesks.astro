---
/** Direct phone and WhatsApp actions plus the office location card for the Contact page. */
import Container from '../Container.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { phoneContact, whatsappContact } from '../../lib/publicContact';

const phone = phoneContact;
const whatsapp = whatsappContact;
---

<section id="contact-options" class="w-full py-16 bg-surface" data-scroll-reveal>
  <Container>
    <div class="grid grid-cols-1 gap-8 items-stretch lg:grid-cols-2">
      <!-- Left column — Direct Communication Channels -->
      <div class="flex flex-col">
        <div
          class="h-full rounded-card border border-outline-variant bg-surface-container-lowest p-8 lg:p-10 shadow-sm"
        >
          <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">
            Direct Communication Channels
          </span>
          <h2 class="mt-2 font-headline-md text-headline-md tracking-tight text-on-surface">
            Reach our engineering desk
          </h2>
          <p class="mt-3 font-body-md text-body-md leading-relaxed text-secondary max-w-[46rem]">
            Message us on WhatsApp or call the office directly. We typically reply within
            30 minutes during business hours.
          </p>
          <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {whatsapp.status === 'ready' && (
              <a
                href={whatsapp.href}
                aria-label={`Chat with Rajarata Engineering on WhatsApp at ${whatsapp.displayNumber}`}
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-control bg-whatsapp px-5 py-3 font-label-md text-label-md text-white transition-colors hover:bg-whatsapp-hover active:translate-y-px focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <WhatsAppIcon class="h-5 w-5" />
                <span>Chat on WhatsApp</span>
              </a>
            )}
            {phone.status === 'ready' && (
              <a
                href={phone.href}
                aria-label={`Call Rajarata Engineering at ${phone.displayNumber}`}
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-control border border-outline-variant bg-surface-container-lowest px-5 py-3 font-label-md text-label-md text-on-surface transition-colors hover:bg-surface-container-high active:translate-y-px focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <span class="material-symbols-outlined" aria-hidden="true">call</span>
                <span>Call {phone.displayNumber}</span>
              </a>
            )}
            <p class="col-span-full mt-2 text-xs text-secondary">
              Typically replies within 30 minutes
            </p>
          </div>
        </div>
      </div>

      <!-- Right column — Office & Service Hub Location -->
      <div class="flex h-full flex-col rounded-card border border-outline-variant bg-surface-container-lowest p-6 lg:p-8 shadow-sm">
        <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">
          Head Office &amp; Operations
        </span>
        <h3 class="mt-2 font-headline-sm text-headline-sm tracking-tight text-on-surface">
          Anuradhapura, Sri Lanka
        </h3>
        <p class="mt-3 font-body-md text-body-md leading-relaxed text-secondary">
          Visit our operations hub for project consultations, MV/LV distribution
          quotes, and industrial installation planning.
        </p>
        <div class="mt-6 flex min-h-[200px] flex-col overflow-hidden rounded-xl border border-outline-variant bg-surface-container-high">
          <iframe
            class="w-full h-full block"
            data-site-map-embed
            data-live-media
            src="https://www.openstreetmap.org/export/embed.html?bbox=80.38%2C8.32%2C80.44%2C8.37&amp;layer=mapnik"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            aria-label="Head office location on OpenStreetMap"
            title="Head office location"
          ></iframe>
          <a
            href="https://www.openstreetmap.org/#map=13/8.35/80.41"
            target="_blank"
            rel="noopener noreferrer"
            data-site-map-link
            class="mt-3 inline-flex w-full items-center justify-center gap-2 text-center font-label-sm text-label-sm text-primary hover:underline focus:outline-none focus-visible:underline"
          >
            Open in OpenStreetMap
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
