---
/**
 * Why choose us (Step 5.6)
 * Section refreshed to the client's six proven-value cards.
 * Grid moved to 3 columns so six cards sit evenly (2 rows x 3 on desktop).
 * All icons are names already present in the self-hosted Material Symbols
 * subset, so no font rebuild is required.
 */
import Container from "../Container.astro";
---

<section class="w-full bg-surface-container-lowest py-16 lg:py-24" data-scroll-reveal>
  <Container>
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto space-y-4 mb-14">
      <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary"
        >Proven Excellence</span
      >
      <h2 class="font-headline-lg text-headline-lg text-on-surface"
        >Why Choose Rajarata Engineering</h2
      >
      <p class="font-body-lg text-body-lg text-secondary">
        Engineering rigor, technical competence, and complete regulatory accountability deployed on every site.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Feature 1 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl"
            >verified_user</span
          >
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Skilled and Experienced Team</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Certified electricians with hands-on experience across MV/LV distribution, panel work, and ELV installations.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">high_quality</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Quality Workmanship</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Clean terminations, accurate labelling, and documented test results on every site.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">health_and_safety</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Safety First</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Safe working practice guides every visit, from isolation and testing through to final handover.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">schedule</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">On-Time Project Completion</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Scheduled milestones and clear handover dates so your project finishes when promised.
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">balance</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Competitive Pricing</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Fair, transparent pricing with no hidden costs on electrical contracting work.
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="card-interactive card-tilt p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4" data-card-tilt>
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">done_all</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Customer Satisfaction</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          Finished work you can trust, with clear communication and a clean handover every time.
        </p>
      </div>
    </div>
  </Container>
</section>
