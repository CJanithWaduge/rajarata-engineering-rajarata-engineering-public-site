---
/**
 * Hero — section 1 of the Home page.
 *
 * Source: the first <section> in UI-UX-design/home_rajarata_engineering/code.html
 *
 * Structure. Full-bleed background photograph with the content layered on top:
 *   - image    — absolute, covers the whole section (`object-cover`)
 *   - scrims   — flat tint plus left-to-right and bottom-up gradients so the
 *                copy stays legible over the brighter parts of the photo
 *   - content  — eyebrow pill, h1, intro paragraph, CTA row, and two glass
 *                feature cards at the bottom
 *
 * Note: Astro does NOT strip HTML comments from templates, so nothing
 * explanatory belongs in the markup below — it would ship to production.
 * Planning notes live in this frontmatter block instead, which is stripped.
 *
 * Anchor targets. Both CTA hrefs point at ids that do not exist yet, so both
 * are inert until those sections are built:
 *   #contact        — Contact page, not started
 *   #services-list  — Services grid, step 4.1 must add `id="services-list"`
 *
 * Hero photograph: the source PNG lives at the repo root
 * (`Rajarata Engineering Electrical Panel Work.png`); the optimised WebP in
 * `public/images/` is what ships.
 *
 * Cropping. The photo is 16:9 but the hero box is narrower than that on
 * desktop, so `object-position` is biased right (62%) to keep the technician
 * and the panel — the interesting half — inside the frame while the copy sits
 * over the darker left side.
 *
 * Deliberately no `width`/`height` on the image: it fills the absolutely
 * positioned box at `h-full object-cover`, so there is no layout shift to
 * prevent and intrinsic dimensions would be ignored anyway.
 *
 * Overlay stacking. The image is `-z-20`, the scrims `-z-10`, and the
 * Container is `relative` so the copy sits above all three without needing a
 * z-index on every child.
 */
import Container from '../Container.astro';
import Button from '../ui/Button.astro';
import { getPublicContactActions } from '../../lib/publicContact';

const { primary: primaryContactAction } = getPublicContactActions();
---

<section
  class="relative isolate w-full overflow-hidden bg-inverse-surface"
  data-scroll-reveal
>
  <img
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_center]"
    src="/images/hero-electrical-panel.webp"
    alt="Rajarata Engineering technician in a safety helmet testing an electrical distribution panel"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-inverse-surface/65" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-inverse-surface via-inverse-surface/80 to-inverse-surface/15"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-inverse-surface/85 to-transparent"
    aria-hidden="true"
  >
  </div>

  <Container class="relative">
    <div
      class="flex min-h-[480px] flex-col justify-center py-16 sm:min-h-[540px] sm:py-20 lg:min-h-[600px] lg:py-24"
    >
      <div class="flex max-w-3xl flex-col items-start space-y-6">
        <p
          class="inline-flex items-center gap-2.5 rounded-full border border-on-primary/20 bg-on-primary/10 px-3 py-1.5 backdrop-blur-sm"
        >
          <span
            class="h-2.5 w-2.5 rounded-full bg-primary-container animate-pulse"
            aria-hidden="true"></span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-primary"
            >Electrical Engineering &amp; Solutions</span
          >
        </p>

        <h1
          class="text-[34px] leading-[1.12] tracking-tight text-on-primary sm:text-[46px] lg:text-[56px] font-display-hero"
        >
          Reliable Electrical Solutions Built for Safety &amp; Performance
        </h1>

        <p
          class="w-full max-w-[36rem] font-body-lg text-body-lg leading-relaxed text-on-primary/80"
        >
          Rajarata Engineering is an electrical engineering and contracting company based in Anuradhapura. We design, install, test, and commission MV/LV distribution, industrial installations, and ELV systems for residential, commercial, and industrial clients.
        </p>

        <div
          class="flex w-full flex-col items-stretch gap-4 pt-2 sm:w-auto sm:flex-row sm:items-center"
        >
          <Button variant="primary" href={primaryContactAction.href}>
            <span>{primaryContactAction.label}</span>
            <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
          </Button>
          <Button variant="secondary" href="#services-list">EXPLORE SERVICES</Button>
        </div>
      </div>

      <div class="mt-12 grid w-full max-w-[42rem] grid-cols-1 gap-4 sm:mt-14 sm:grid-cols-2">
        <div
          class="flex items-center gap-3.5 rounded-2xl border border-on-primary/15 bg-on-primary/10 p-4 backdrop-blur-md"
        >
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary-container text-on-primary"
          >
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">shield</span>
          </div>
          <div class="flex min-w-0 flex-col">
            <span class="font-title-md text-title-md leading-tight text-on-primary"
              >Safety-First Site Work</span
            >
            <span class="font-label-sm text-label-sm text-on-primary/70"
              >Planned, supervised installation</span
            >
          </div>
        </div>

        <div
          class="flex items-center gap-3.5 rounded-2xl border border-on-primary/15 bg-on-primary/10 p-4 backdrop-blur-md"
        >
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary-container text-on-primary"
          >
            <span class="material-symbols-outlined text-2xl" aria-hidden="true"
              >verified</span
            >
          </div>
          <div class="flex min-w-0 flex-col">
            <span class="font-title-md text-title-md leading-tight text-on-primary"
              >Tested &amp; Commissioned</span
            >
            <span class="font-label-sm text-label-sm text-on-primary/70"
              >Every system verified before handover</span
            >
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
