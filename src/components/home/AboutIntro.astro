---
/**
 * About introduction (Step 3.12)
 * Added live stat strip: bg-white/5, health_and_safety icon (text-emerald-400),
 * "Zero Hazard Index" / "Uncompromised site safety record", done_all icon.
 *
 * NOTE: text-emerald-400 and bg-emerald-400 are the only stock Tailwind colours
 * in the build. DESIGN.md defines no green token. This is a deliberate prototype
 * carry-over — see IMPLEMENTATION.md. Flagged for design decision, not changed.
 */
import Container from "../Container.astro";
---

<section class="w-full bg-surface-container-lowest py-16 lg:py-24" data-scroll-reveal>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Text Details -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="flex items-center gap-2">
          <span class="w-8 h-1 bg-primary-container rounded-full"></span>
          <span class="font-label-caps text-label-caps uppercase text-primary tracking-wider"
            >About Rajarata Engineering</span
          >
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface leading-tight">
          Engineering Solutions You Can Rely On
        </h2>
        <p class="font-body-lg text-body-lg text-secondary leading-relaxed">
          Rajarata Engineering is an electrical engineering and contracting company based in Anuradhapura, Sri Lanka. We plan, install, test, and hand over MV/LV distribution systems, industrial installations, and ELV/automation works — working to the requirements of each site and each client.
        </p>

        <!-- Core Capability Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 pt-2">
          <div class="card-interactive card-tilt p-4 rounded-xl bg-surface-container-low flex flex-col space-y-2" data-card-tilt>
            <span class="material-symbols-outlined text-primary-container text-2xl"
              >verified_user</span
            >
            <span class="font-title-md text-title-md text-on-surface">Safety Compliance</span>
            <p class="font-body-sm text-body-sm text-secondary">
              Isolation, testing, and safe working procedures are planned into every stage of an installation, from first conduit run to final handover.
            </p>
          </div>
          <div class="card-interactive card-tilt p-4 rounded-xl bg-surface-container-low flex flex-col space-y-2" data-card-tilt>
            <span class="material-symbols-outlined text-primary-container text-2xl">engineering</span>
            <span class="font-title-md text-title-md text-on-surface">Skilled Engineering Team</span>
            <p class="font-body-sm text-body-sm text-secondary">
              Our engineers and electricians handle design, panel assembly, cable work, and commissioning as one coordinated scope of work.
            </p>
          </div>
          <div class="card-interactive card-tilt p-4 rounded-xl bg-surface-container-low flex flex-col space-y-2" data-card-tilt>
            <span class="material-symbols-outlined text-primary-container text-2xl">tune</span>
            <span class="font-title-md text-title-md text-on-surface">Precision Equipment</span>
            <p class="font-body-sm text-body-sm text-secondary">
              Calibrated test instruments and proper installation tooling support accurate results and clean workmanship on site.
            </p>
          </div>
        </div>
        <div class="pt-4">
          <a
            class="inline-flex items-center gap-2 font-label-md text-label-md text-primary-container hover:text-primary transition-colors group"
            data-path="about-us"
            href="/about-us">
            <span class="uppercase tracking-wider">About Us</span>
            <span class="material-symbols-outlined text-lg transition-transform group-hover:translate-x-1"
              >arrow_right_alt</span
            >
          </a>
        </div>
      </div>

      <!-- Metric & Operational Highlights Card -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="p-8 rounded-2xl bg-inverse-surface text-on-primary shadow-xl relative overflow-hidden">
          <div class="relative z-10 flex flex-col space-y-6">
            <div class="flex items-center justify-between pb-4">
              <span class="font-label-caps text-label-caps tracking-widest text-primary-fixed uppercase"
                >System Specifications</span
              >
              <span class="px-2.5 py-1 rounded bg-surface-container-highest/20 font-label-sm text-label-sm text-white"
                >Verified by testing</span
              >
            </div>

            <!-- Data Point 1 -->
            <div class="flex flex-col space-y-1">
              <span class="font-label-caps text-label-caps text-gray-400 uppercase"
                >Quality Benchmarks</span
              >
              <span class="font-headline-md text-headline-md font-bold text-white tracking-tight"
                >Tested &amp; recorded at every stage</span
              >
              <span class="font-body-sm text-body-sm text-gray-400">
                Insulation, loop impedance, and earth tests carried out before energisation
              </span>
            </div>
            <div class="w-full h-px bg-white/10"></div>

            <!-- Data Point 2 -->
            <div class="flex flex-col space-y-1">
              <span class="font-label-caps text-label-caps text-gray-400 uppercase"
                >Compliance Threshold</span
              >
              <span class="font-headline-md text-headline-md font-bold text-primary-fixed tracking-tight"
                >Safety planned into every job</span
              >
              <span class="font-body-sm text-body-sm text-gray-400">
                Careful practice across residential, commercial &amp; industrial grade work
              </span>
            </div>

            <!-- Live Stat Strip Graphic -->
            <div class="pt-4 flex items-center justify-between p-3 rounded-xl bg-white/5">
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-400 text-2xl"
                  >health_and_safety</span
                >
                <div class="flex flex-col">
                  <span class="font-label-sm text-label-sm text-white">Safety on Site</span>
                  <span class="font-body-sm text-body-sm text-gray-400"
                    >Planned work, protected people, secure handover</span
                  >
                </div>
              </div>
              <span class="material-symbols-outlined text-gray-500">done_all</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
