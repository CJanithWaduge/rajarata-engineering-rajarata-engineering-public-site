---
/**
 * Trust strip - credibility indicators for the home page.
 */
import Container from "../Container.astro";

const defaultItems = [
  { title: 'Electrical Installations', description: 'MV & LV Distribution', icon: 'electric_meter' },
  { title: 'Industrial Solutions', description: 'Manufacturing & Plants', icon: 'factory' },
  { title: 'Testing & Commissioning', description: 'Calibrated Diagnostic Rig', icon: 'troubleshoot' },
  { title: 'ELV Solutions', description: 'Smart Automation & Data', icon: 'router' },
];
---

<section class="w-full bg-surface-container-low py-8">
  <Container>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {defaultItems.map((item) => (
        <div class="card-interactive card-tilt flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm" data-card-tilt>
          <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">{item.icon}</span>
          </div>
          <div class="flex flex-col">
            <span class="font-title-md text-title-md text-on-surface">{item.title}</span>
            <span class="font-body-sm text-body-sm text-secondary">{item.description}</span>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
