---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/material-symbols-outlined.woff2"
      crossorigin
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-background text-on-surface font-sans antialiased">
    <slot />
    <script>
      import { initCardTilt } from '../lib/cardTilt';
      import { initScrollReveal } from '../lib/scrollReveal';
      import { startContentHydration } from '../lib/contentHydration';

      initCardTilt();
      initScrollReveal();
      // Keeps contact details, the Home hero and the Services copy in sync
      // with the admin panel. Imports Firestore after load, on an idle slot,
      // and only for the feeds this page actually renders.
      startContentHydration();
    </script>
  </body>
</html>
