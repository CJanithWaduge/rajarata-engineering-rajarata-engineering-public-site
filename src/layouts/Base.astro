---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.svg" data-site-favicon data-default-href="/favicon.svg" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/material-symbols-outlined.woff2"
      crossorigin
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}

    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://firestore.googleapis.com" />

    <!--
      The prerendered content can be older than Firestore. Hide opted-in live
      media and copy before first paint so stale values do not flash while the
      server snapshot is loading. Hydration releases the gate after
      server-confirmed snapshots (or errors); a failed client script releases
      it to show the static fallback. Without JavaScript the gate is never set.
    -->
    <script is:inline>
      document.documentElement.setAttribute('data-live-content', 'pending');
      window.addEventListener(
        'error',
        function (event) {
          if (event.target instanceof HTMLScriptElement) {
            document.documentElement.removeAttribute('data-live-content');
          }
        },
        true,
      );
    </script>
  </head>
  <body class="bg-background text-on-surface font-sans antialiased">
    <slot />
    <script>
      import { initCardTilt } from '../lib/cardTilt';
      import { initScrollReveal } from '../lib/scrollReveal';
      import { startContentHydration } from '../lib/contentHydration';

      initCardTilt();
      initScrollReveal();
      // Hydrates admin-managed content from server-confirmed Firestore snapshots.
      startContentHydration();
    </script>
  </body>
</html>
