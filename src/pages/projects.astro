---
/**
 * Projects page.
 *
 * Route shell with the shared layout. Section components land in
 * src/components/projects/ and are rendered here as the Phase 5
 * steps come in.
 *
 * `pt-20` clears the fixed header — same arrangement as Home,
 * Services, and About Us.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectsHero from '../components/projects/ProjectsHero.astro';
import ProjectPortfolio from '../components/projects/ProjectPortfolio.astro';
import ProjectTrackRecord from '../components/projects/ProjectTrackRecord.astro';
import ProjectsCta from '../components/projects/ProjectsCta.astro';

export const prerender = true;
---

<Base
  title="Rajarata Engineering | Projects"
  description="Electrical engineering and contracting in Anuradhapura, Sri Lanka — MV/LV distribution, MDB/SMDB panel installation, industrial installations, ELV/automation, lightning protection, and testing and commissioning."
>
  <Header />

  <main class="w-full pt-20 bg-surface">
    <ProjectsHero />
    <ProjectPortfolio />
    <ProjectTrackRecord />
    <ProjectsCta />
  </main>

  <Footer />
</Base>