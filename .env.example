# Public contact details for the static marketing site.
#
# Copy this file to `.env` and set the confirmed values. `.env` is gitignored.
# Both values are embedded into the public HTML at build time. They are not
# secrets — they appear on the published Contact page either way.

# Public WhatsApp contact. Include the country code; digits only.
# Update the confirmed value when it changes.
PUBLIC_WHATSAPP_NUMBER=94771234567

# Public phone contact. Include the country code in international format.
PUBLIC_CONTACT_PHONE=+94 25 112 3456

# Production mode. false enables the owner-approved content gate in
# scripts/build-spark.mjs, which fails the build if any sample or placeholder
# wording reaches the rendered HTML.
PUBLIC_DEMO_MODE=false
