# Public contact details for the static marketing site.
#
# Copy this file to `.env` and set the confirmed values. `.env` is gitignored.
# The values below are embedded into the public HTML at build time. They are not
# secrets — they appear on the published Contact page either way.
#
# Live values now come from Firestore (`site/settings`, written by the admin
# panel). These keys are only the initial paint, so the static HTML is correct
# before JavaScript runs; `src/lib/watchSiteSettings.ts` replaces them at
# runtime. Leave a key empty to hide that row.

# Public WhatsApp contact. Include the country code; digits only.
PUBLIC_WHATSAPP_NUMBER=94771234567

# Public phone contact. Include the country code in international format.
PUBLIC_CONTACT_PHONE=+94 25 112 3456

# Public email address. Shown in the footer and on the Contact page.
PUBLIC_EMAIL=

# Public Facebook page URL. Absolute https URL.
PUBLIC_FACEBOOK_URL=

# Short location label, e.g. "Anuradhapura, Sri Lanka".
PUBLIC_LOCATION=Anuradhapura, Sri Lanka

# Firebase web config for reading CMS content. Public by design; access is
# enforced by Firestore Security Rules.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Firestore database id. Defaults to `(default)` when empty.
PUBLIC_FIREBASE_DATABASE_ID=default

# Production mode. false enables the owner-approved content gate in
# scripts/build-spark.mjs, which fails the build if any sample or placeholder
# wording reaches the rendered HTML.
PUBLIC_DEMO_MODE=false
