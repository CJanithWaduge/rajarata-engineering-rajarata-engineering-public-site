{
  "name": "rajarata-engineering",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "check": "astro check",
    "test:whatsapp": "node --experimental-strip-types --test tests/whatsapp.test.mjs",
    "test:phone": "node --experimental-strip-types --test tests/phone.test.mjs",
    "test:spark": "node --test tests/spark-hosting.test.mjs",
    "test:site": "npm run check && npm run build && npm run test:spark && npm run test:whatsapp && npm run test:phone",
    "build:spark": "node --env-file-if-exists=.env scripts/build-spark.mjs",
    "deploy:spark": "node --env-file-if-exists=.env scripts/deploy-spark.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "firebase": "^13.0.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "firebase-tools": "^15.34.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
